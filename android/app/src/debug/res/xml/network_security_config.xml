<?xml version="1.0" encoding="utf-8"?>
<!--
  Yalniz DEBUG build ucun.

  Android 9+ sifrelenmemis HTTP-ni bloklayir. Lokal development-de
  backend http://10.0.2.2:8080 uzerinde isleyir (10.0.2.2 emulyatordan
  host masina gedis unvanidir), ona gore hemin hostlara istisna verilir.

  Release build bu faylı istifade etmir — prod HTTPS teleb edir.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulyatordan host masina -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Cihazin ozu -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
